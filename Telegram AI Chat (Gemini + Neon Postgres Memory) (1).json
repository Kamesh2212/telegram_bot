    {
      "parameters": {
        "operation": "executeQuery",
        "query": "BEGIN;\n\n-- Users\nINSERT INTO tg_users (telegram_user_id, username, first_name, last_name, language_code, is_bot)\nVALUES (\n  {{ $('Telegram Trigger').first().json.message.from.id }},\n  {{ $json.message?.from?.username ? \"'\" + $json.message.from.username + \"'\" : 'NULL' }},\n  {{ $json.message?.from?.first_name ? \"'\" + $json.message.from.first_name + \"'\" : 'NULL' }},\n  {{ $json.message?.from?.last_name ? \"'\" + $json.message.from.last_name + \"'\" : 'NULL' }},\n  {{ $json.message?.from?.language_code ? \"'\" + $json.message.from.language_code + \"'\" : 'NULL' }},\n  {{ $json.message?.from?.is_bot ?? false }}\n)\nON CONFLICT (telegram_user_id) DO UPDATE\nSET username = EXCLUDED.username,\n    first_name = EXCLUDED.first_name,\n    last_name = EXCLUDED.last_name,\n    language_code = EXCLUDED.language_code,\n    is_bot = EXCLUDED.is_bot,\n    updated_at = now();\n\n-- Chats (private chats often have no title; we’ll use first_name if present)\nINSERT INTO tg_chats (chat_id, chat_type, title)\nVALUES (\n  {{ $('Telegram Trigger').first().json.message.chat.id }},\n  {{ \"'\" + $('Telegram Trigger').first().json.message.chat.type + \"'\" }},\n  {{\n    $json.message?.chat?.title\n      ? \"'\" + $json.message.chat.title + \"'\"\n      : ($json.message?.chat?.first_name ? \"'\" + $json.message.chat.first_name + \"'\" : 'NULL')\n  }}\n)\nON CONFLICT (chat_id) DO UPDATE\nSET chat_type = EXCLUDED.chat_type,\n    title = COALESCE(EXCLUDED.title, tg_chats.title),\n    updated_at = now();\n\nCOMMIT;\n",
        "options": {}
      },
